<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/lyt_connection_test_final"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/efevoo_gradient_color"
        android:orientation="vertical">

        <include layout="@layout/toolbar_layout" />


        <LinearLayout
            android:id="@+id/lyt_connection_test_final_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_connection_test_final"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/connection_img" />

            <TextView
                android:id="@+id/txt_connection_success_title"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans_medium"
                android:gravity="center"
                android:text="@string/wmx_connection_test_final_title"
                android:textColor="#FFFFFF"
                android:textSize="40px" />

            <TextView
                android:id="@+id/txt_connection_success_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans"
                android:gravity="center"
                android:text="date"
                android:textColor="#FFFFFF"
                android:textSize="30px" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lyt_connection_test_final_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:paddingLeft="30dp"
            android:paddingTop="30dp"
            android:paddingRight="30dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@drawable/rounded_corner"
                    android:backgroundTint="#F4F4F4"
                    android:orientation="horizontal"
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp">

                    <TextView
                        android:id="@+id/txt_connection_test_kpos_id_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:fontFamily="@font/dm_sans"
                        android:text="@string/wmx_connection_test_final_kpos_id_title"
                        android:textSize="30px" />

                    <TextView
                        android:id="@+id/txt_connection_test_kpos_id_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="end"
                        android:text="12345678"
                        android:textSize="30px" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lyt_connection_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txt_connection_error_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/wmx_connection_test_error_1"
                        android:textColor="#121212"
                        android:textSize="24px" />

                    <TextView
                        android:id="@+id/txt_connection_error_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/wmx_connection_test_error_2"
                        android:textColor="#121212"
                        android:textSize="30px" />

                    <TextView
                        android:id="@+id/txt_connection_error_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/wmx_connection_test_error_3"
                        android:textColor="#121212"
                        android:textSize="30px" />

                    <TextView
                        android:id="@+id/txt_connection_error_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/wmx_connection_test_error_4"
                        android:textColor="#121212"
                        android:textSize="20px" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_connection_test_continue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_corner"
                    android:backgroundTint="#000000"
                    android:text="Button"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>