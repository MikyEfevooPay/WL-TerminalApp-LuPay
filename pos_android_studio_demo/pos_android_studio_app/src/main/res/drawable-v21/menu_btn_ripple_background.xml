<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/colorPrimaryDark">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/ep_btn_menu_texto" />
            <corners android:radius="@dimen/dp_14" />
        </shape>
    </item>

    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="@color/ep_btn_menu_fondo"
                android:startColor="@color/ep_btn_menu_fondo"
                android:type="linear" />
            <corners android:radius="@dimen/dp_16" />
            <stroke android:width="1px" android:color="@color/ep_btn_menu_texto"/>
        </shape>
    </item>
</ripple>