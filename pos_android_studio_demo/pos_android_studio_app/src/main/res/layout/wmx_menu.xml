<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ep_fondo"
    android:orientation="vertical">

    <include layout="@layout/toolbar_layout" />

    <!--<ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/prueba1__1_" />-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="95px"
        android:layout_marginTop="15px"
        android:layout_marginBottom="15px"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="342.72px"
            android:layout_gravity="center"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/logo_cohetepay" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30px"
            android:layout_marginRight="30px"
            android:orientation="vertical">

            <GridLayout
                android:layout_width="fill_parent"
                android:layout_height="match_parent"
                android:columnCount="2"
                android:orientation="horizontal"
                android:useDefaultMargins="true"
                android:layout_marginEnd="-20dp"
                >

                <LinearLayout
                    android:id="@+id/btn_transfer"
                    android:layout_width="0dp"
                    android:layout_height="160px"
                    android:layout_columnWeight="1"
                    android:background="@drawable/menu_btn_ripple_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    >

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="match_parent"
                            android:layout_height="62px"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/m_transacciones" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/textView19"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_sans_bold"
                        android:text="@string/wmx_menu_transfer"
                        android:textAllCaps="false"
                        android:textColor="@color/ep_btn_menu_texto"
                        android:textSize="20px" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_meses"
                    android:layout_width="0dp"
                    android:layout_height="160px"
                    android:layout_columnWeight="1"
                    android:background="@drawable/menu_btn_ripple_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="match_parent"
                            android:layout_height="62px"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/m_meses_sin_intereses" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/textView19"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_sans_bold"
                        android:gravity="center"
                        android:lineSpacingMultiplier="0.8"
                        android:text="@string/wmx_menu_meses"
                        android:textAlignment="center"
                        android:textAllCaps="false"
                        android:textColor="@color/ep_btn_menu_texto"
                        android:textSize="18px" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_cancelaciones"
                    android:layout_width="0dp"
                    android:layout_height="160px"
                    android:layout_columnWeight="1"
                    android:background="@drawable/menu_btn_ripple_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="match_parent"
                            android:layout_height="62px"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/m_cancelaciones" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/textView19"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_sans_bold"
                        android:text="@string/wmx_menu_cancel"
                        android:textAllCaps="false"
                        android:textColor="@color/ep_btn_menu_texto"
                        android:textSize="20px" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_Other"
                    android:layout_width="0dp"
                    android:layout_height="160px"
                    android:layout_columnWeight="1"
                    android:background="@drawable/menu_btn_ripple_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="match_parent"
                            android:layout_height="65px"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/m_historial" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/textView19"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_sans_bold"
                        android:text="@string/wmx_menu_Other"
                        android:textAllCaps="false"
                        android:textColor="@color/ep_btn_menu_texto"
                        android:textSize="20px" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_connection_test"
                    android:layout_width="0dp"
                    android:layout_height="160px"
                    android:layout_columnWeight="1"
                    android:background="@drawable/menu_btn_ripple_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    >

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/img_connection_test"
                            android:layout_width="match_parent"
                            android:layout_height="62px"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/m_prueba_de_comunicaci_n" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_connection_test_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_sans_bold"
                        android:gravity="center"
                        android:text="Prueba de comunicación"
                        android:textAlignment="center"
                        android:textAllCaps="false"
                        android:textColor="@color/ep_btn_menu_texto"
                        android:textSize="20px" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_cortecaja"
                    android:layout_width="0dp"
                    android:layout_height="160px"
                    android:layout_columnWeight="1"
                    android:background="@drawable/menu_btn_ripple_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"

                    >

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="match_parent"
                            android:layout_height="62px"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/m_corte_de_caja" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/textView19"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_sans_bold"
                        android:text="Corte de Caja"
                        android:textAllCaps="false"
                        android:textColor="@color/ep_btn_menu_texto"
                        android:textSize="20px" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_Ajustes"
                    android:layout_width="0dp"
                    android:layout_height="160px"
                    android:layout_columnWeight="1"
                    android:background="@drawable/menu_btn_ripple_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="match_parent"
                            android:layout_height="62px"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/m_informaci_n" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/textView19"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_sans_bold"
                        android:text="@string/wmx_menu_Ajustes"
                        android:textAllCaps="false"
                        android:textColor="@color/ep_btn_menu_texto"
                        android:textSize="20px" />

                </LinearLayout>


            </GridLayout>
        </LinearLayout>
    </ScrollView>


</LinearLayout>