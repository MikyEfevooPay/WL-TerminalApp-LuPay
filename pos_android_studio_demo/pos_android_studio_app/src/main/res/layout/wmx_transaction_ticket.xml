<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lyt_transaction_print"
    android:layout_width="384px"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/img_ticket_logo"
        android:layout_width="match_parent"
        android:layout_height="42px"
        app:srcCompat="@drawable/logo_cohetepay_bmp_try3" />

    <LinearLayout
        android:id="@+id/lyt_ticket_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">

        <TextView
            android:id="@+id/txt_company"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans_bold"
            android:gravity="center"
            android:text="Company"
            android:textColor="#000000"
            android:textSize="7dp" />

        <TextView
            android:id="@+id/txt_address_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans_medium"
            android:gravity="center"
            android:text="adress 1"
            android:textColor="#000000"
            android:textSize="7dp" />

        <TextView
            android:id="@+id/txt_address_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans_medium"
            android:gravity="center"
            android:text="adress 2"
            android:textColor="#000000"
            android:textSize="7dp" />

        <TextView
            android:id="@+id/txt_address_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans_medium"
            android:gravity="center"
            android:text="adress 3"
            android:textColor="#000000"
            android:textSize="7dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ticket_separator_tiny"
        android:layout_width="30dp"
        android:layout_height="1px"
        android:layout_gravity="center"
        android:background="#000000"
        android:gravity="center"
        android:orientation="horizontal">

    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ticket_card_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">

        <TextView
            android:id="@+id/txt_transaction_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans_bold"
            android:gravity="center"
            android:text="transaction type"
            android:textColor="#000000"
            android:textSize="7dp" />

        <TextView
            android:id="@+id/txt_ticket_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans_medium"
            android:gravity="center"
            android:text="date"
            android:textColor="#000000"
            android:textSize="7dp" />

        <TextView
            android:id="@+id/txt_ticket_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans_medium"
            android:gravity="center"
            android:text="@string/wmx_ticket_card_number"
            android:textColor="#000000"
            android:textSize="7dp" />

        <TextView
            android:id="@+id/txt_ticket_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans_medium"
            android:gravity="center"
            android:text="number"
            android:textColor="#000000"
            android:textSize="7dp" />

        <TextView
            android:id="@+id/txt_ticket_card_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans_medium"
            android:gravity="center"
            android:text="card type"
            android:textColor="#000000"
            android:textSize="7dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ticket_separator"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#000000"
        android:orientation="horizontal">

    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ticket_amounts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="7px"
            android:paddingRight="7px"
            >

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/txt_ticket_consumo_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans_medium"
                    android:gravity="left"
                    android:text="@string/wmx_ticket_consumo"
                    android:textColor="#000000"
                    android:textSize="7dp" />

                <TextView
                    android:id="@+id/txt_ticket_consumo_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans_medium"
                    android:gravity="right"
                    android:text="value"
                    android:textColor="#000000"
                    android:textSize="7dp" />
            </TableRow>

            <TableRow
                android:id="@+id/tbl_ticket_tip"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/txt_ticket_tip_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans_medium"
                    android:gravity="left"
                    android:text="@string/wmx_ticket_tip"
                    android:textColor="#000000"
                    android:textSize="7dp" />

                <TextView
                    android:id="@+id/txt_ticket_tip_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans_medium"
                    android:gravity="right"
                    android:text="value"
                    android:textColor="#000000"
                    android:textSize="7dp" />
            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/txt_ticket_total_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans_bold"
                    android:gravity="left"
                    android:text="@string/wmx_ticket_total"
                    android:textColor="#000000"
                    android:textSize="8dp" />

                <TextView
                    android:id="@+id/txt_ticket_total_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans_bold"
                    android:gravity="right"
                    android:text="value"
                    android:textColor="#000000"
                    android:textSize="9dp" />
            </TableRow>

        </TableLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ticket_separator"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#000000"
        android:orientation="horizontal"></LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ticket_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">

        <TextView
            android:id="@+id/txt_ticket_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/dm_sans_bold"
            android:gravity="center"
            android:text="Status"
            android:textColor="#000000"
            android:textSize="7dp" />

        <TextView
            android:id="@+id/txt_ticket_entity_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/dm_sans_medium"
            android:gravity="center"
            android:text="Entity"
            android:textColor="#000000"
            android:textSize="7dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ticket_commerce_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">

        <LinearLayout
            android:id="@+id/lyt_ticket_separator_tiny_commerce"
            android:layout_width="30dp"
            android:layout_height="1px"
            android:layout_gravity="center"
            android:layout_marginBottom="5dp"
            android:background="#000000"
            android:gravity="center"
            android:orientation="horizontal">

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lyt_ticket_sign"
            android:layout_width="match_parent"
            android:layout_height="2px"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="16dp"
            android:background="#000000"
            android:orientation="horizontal"></LinearLayout>

        <TextView
            android:id="@+id/txt_ticket_commerce_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/dm_sans_bold"
            android:gravity="center"
            android:text="Commerce"
            android:textColor="#000000"
            android:textSize="7dp" />

        <TextView
            android:id="@+id/txt_ticket_sign_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/dm_sans_medium"
            android:gravity="center"
            android:text="sign_message"
            android:textColor="#000000"
            android:textSize="7dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ticket_separator_tiny"
        android:layout_width="30dp"
        android:layout_height="1px"
        android:layout_gravity="center"
        android:background="#000000"
        android:gravity="center"
        android:orientation="horizontal">

    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ticket_terminal_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">

        <TextView
            android:id="@+id/txt_ticket_kposId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/dm_sans_medium"
            android:gravity="center"
            android:text="kposId"
            android:textColor="#000000"
            android:textSize="7dp" />

        <TextView
            android:id="@+id/txt_ticket_aid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/dm_sans_medium"
            android:gravity="center"
            android:text="AID"
            android:textColor="#000000"
            android:textSize="7dp" />

        <TextView
            android:id="@+id/txt_ticket_arqc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/dm_sans_medium"
            android:gravity="center"
            android:text="ARQC"
            android:textColor="#000000"
            android:textSize="7dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ticket_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_ticket_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/dm_sans"
            android:gravity="center"
            android:text=""
            android:textColor="#000000"
            android:textSize="20.5dp" />
    </LinearLayout>

</LinearLayout>