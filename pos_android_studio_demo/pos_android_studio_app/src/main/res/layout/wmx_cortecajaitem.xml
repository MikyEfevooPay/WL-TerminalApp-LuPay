<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="17px">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:background="@drawable/rounded_corner"
        android:backgroundTint="#FFFFFF"
        android:paddingLeft="21px"
        android:paddingTop="7dp"
        android:paddingRight="21px"
        android:paddingBottom="7dp"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:layout_width="100px"
            android:layout_height="wrap_content"
            android:layout_marginRight="10px"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView21"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans"
                android:paddingBottom="5dp"
                android:text="Cantidad"
                android:textColor="#121212"
                android:textSize="16px" />

            <TextView
                android:id="@+id/textView17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans"
                android:paddingBottom="5dp"
                android:text="Identificador"
                android:textColor="#121212"
                android:textSize="16px" />

            <TextView
                android:id="@+id/textView29"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans"
                android:text="Fecha y Hora"
                android:textColor="#121212"
                android:textSize="16px" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="49dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:orientation="vertical">


            <TextView
                android:id="@+id/wmx_historial_cantidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans_medium"
                android:gravity="right"
                android:paddingBottom="5dp"
                android:text="$1.00 mxn"
                android:textColor="#121212"
                android:textSize="16px" />

            <TextView
                android:id="@+id/wmx_historial_identificador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans_medium"
                android:gravity="right"
                android:paddingBottom="5dp"
                android:text="1491040530"
                android:textColor="#ADADAD"
                android:textSize="16px" />

            <TextView
                android:id="@+id/wmx_historial_fechahora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans_medium"
                android:gravity="right"
                android:text="21/04/22 00:12"
                android:textColor="#121212"
                android:textSize="16px" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"

                />
        </LinearLayout>


    </LinearLayout>


</LinearLayout>