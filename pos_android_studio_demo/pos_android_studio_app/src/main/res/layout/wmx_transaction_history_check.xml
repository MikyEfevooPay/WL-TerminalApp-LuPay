<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="37px"
        android:paddingTop="28px"
        android:paddingBottom="28px"
        android:paddingRight="37px"
        tools:ignore="MissingConstraints">

        <ImageView
            android:id="@+id/imageView11"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            app:srcCompat="@drawable/efevoo_i_info" />

        <TextView
            android:id="@+id/textView31"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24px"
            android:fontFamily="@font/dm_sans_medium"
            android:gravity="center"
            android:text="@string/wmx_transaction_history_check_title"
            android:textColor="#0F0F0F"
            android:textSize="22px" />

        <TextView
            android:id="@+id/textView30"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/dm_sans"
            android:gravity="center"
            android:text="@string/wmx_transaction_history_check_description"
            android:textColor="#5A5A5A"
            android:textSize="22px" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_go_to_history"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/rounded_corner"
            android:backgroundTint="@color/ep_btn_continuar_fondo"
            android:fontFamily="@font/dm_sans_bold"
            android:stateListAnimator="@null"
            android:text="@string/wmx_go_to_history"
            android:textAllCaps="false"
            android:textColor="#fff"
            android:textSize="22px" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>