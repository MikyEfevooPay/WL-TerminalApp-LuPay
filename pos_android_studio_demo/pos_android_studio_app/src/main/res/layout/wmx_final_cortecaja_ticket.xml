<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ep_fondo_ticket"
    android:orientation="vertical"
    android:paddingLeft="18px"
    android:paddingTop="26px"
    android:paddingRight="18px"
    android:paddingBottom="26px">

    <include layout="@layout/toolbar_layout" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24px"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lbl_corte_ticket_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/dm_sans_medium"
            android:text="@string/wmx_cortecaja_title"
            android:textColor="#FFFFFF"
            android:textSize="22px" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fondo_ticket"
        android:orientation="vertical"
        android:padding="23px">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="78px"
                android:layout_height="43px"
                app:srcCompat="@drawable/logo_efevoopay_coloresai" />

        </LinearLayout>

        <TextView
            android:id="@+id/corte_ticket_tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans_medium"
            android:text="@string/wmx_cortecaja_subtitle"
            android:textColor="#0F0F0F"
            android:textSize="20px" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12px"
            android:text="@string/wmx_cortecaja_subtitle_description"
            android:textSize="16px" />

        <LinearLayout
            android:id="@+id/ticket_ll_subtotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10px"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lbl_cortecaja_fechahora_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_weight="1"
                android:fontFamily="@font/dm_sans"
                android:text="@string/wmx_cortecaja_subtotal_title"
                android:textColor="#121212"
                android:textSize="20px" />

            <TextView
                android:id="@+id/lbl_cortecaja_subtotal_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans"
                android:text="$4,320.00 MXN"
                android:textColor="#5A5A5A"
                android:textSize="20px" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10px"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lbl_cortecaja_propina_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/dm_sans"
                android:text="@string/wmx_cortecaja_propina_title"
                android:textColor="#121212"
                android:textSize="20px" />

            <TextView
                android:id="@+id/lbl_cortecaja_propina_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans"
                android:text="$560.00 MXN"
                android:textColor="#5A5A5A"
                android:textSize="20px" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10px"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lbl_cortecaja_total_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/dm_sans"
                android:text="@string/wmx_cortecaja_total_title"
                android:textColor="#121212"
                android:textSize="20px" />

            <TextView
                android:id="@+id/lbl_cortecaja_total_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans"
                android:text="$4,670.00 MXN"
                android:textColor="#5A5A5A"
                android:textSize="20px" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16px"
            android:layout_marginRight="16px"
            android:layout_marginBottom="23px"
            android:backgroundTint="#A3A6FC"
            android:contentDescription="underline"
            android:layerType="software"
            android:src="@drawable/dotted_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10px"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lbl_cortecaja_fechahora_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/dm_sans"
                android:text="@string/wmx_cortecaja_fechahora_title"
                android:textColor="#121212"
                android:textSize="20px" />

            <TextView
                android:id="@+id/lbl_cortecaja_fechahora_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans"
                android:text="06/05/22 11:23"
                android:textColor="#5A5A5A"
                android:textSize="20px" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lyt_cortecaja_buttons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="23px"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/lyt_cortecaja_print"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txt_cortecaja_print_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8px"
                    android:fontFamily="@font/dm_sans_medium"
                    android:text="@string/wmx_cortecaja_print_title"
                    android:textColor="@color/ep_color_blue"
                    android:textSize="22px" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/flecha_ticket" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyt_cortecaja_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/txt_cortecaja_email_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8px"
                    android:fontFamily="@font/dm_sans_medium"
                    android:text="@string/wmx_cortecaja_email_title"
                    android:textColor="@color/ep_color_blue"
                    android:textSize="22px" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/flecha_ticket" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30px"
            android:gravity="bottom|center_horizontal"

            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_cortecaja_final"
                android:layout_width="match_parent"
                android:layout_height="60px"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="#000000"
                android:fontFamily="@font/dm_sans_bold"
                android:minHeight="50dip"
                android:stateListAnimator="@null"
                android:text="Finalizar"
                android:textAllCaps="false"
                android:textColor="#ffffff"
                android:textSize="22px" />
        </LinearLayout>


    </LinearLayout>

</LinearLayout>