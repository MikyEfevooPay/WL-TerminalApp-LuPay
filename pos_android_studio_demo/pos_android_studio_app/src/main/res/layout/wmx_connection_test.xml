<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/lyt_connection_test"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/efevoo_gradient_color"
        android:orientation="vertical">

        <include layout="@layout/toolbar_layout" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center|center_horizontal|center_vertical"
                android:orientation="vertical">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/connection_test_animation"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_gravity="center"
                    android:visibility="visible"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    android:tooltipText="asdsad"
                    app:lottie_rawRes="@raw/loading_connection" />

                <TextView
                    android:id="@+id/txt_connection_test_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans_medium"
                    android:gravity="center"
                    android:text="@string/wmx_connection_test_title"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="42px"
                    tools:text="@string/wmx_connection_test_title" />

                <TextView
                    android:id="@+id/txt_connection_test_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="center"
                    android:text="@string/wmx_connection_test_subtitle"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="30px"
                    tools:text="@string/wmx_connection_test_subtitle" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>