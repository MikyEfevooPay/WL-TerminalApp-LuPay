<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">


    <item android:state_checked="true">
        <layer-list
            android:width="31px"
            android:height="31px"
            >
            <!-- Larger blue circle -->
            <item

                >
                <shape
                    android:shape="oval" >
                    <corners
                        android:radius="5px"/>

                    <solid android:color="@color/ep_rb_bg" />

                    <stroke android:width="1px"
                        android:color="@color/ep_rb_stroke"
                        />

                    <padding
                        android:bottom="4px"
                        android:left="4px"
                        android:right="4px"
                        android:top="4px" />

                    <size android:height="31px"
                        android:width="31px"/>
                </shape>
            </item>

            <item android:drawable="@drawable/checkmark_outline"
                android:gravity="center"
                android:width="20px"
                android:height="20px">

            </item>

