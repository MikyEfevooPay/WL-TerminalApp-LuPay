<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="37px"
    android:paddingTop="28px"
    android:paddingBottom="28px"
    android:paddingRight="37px">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tp_warning"
            android:layout_width="match_parent"
            android:layout_height="100px"
            android:layout_marginBottom="18px"
            app:srcCompat="@drawable/tarjeta_icono" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ticket_totales"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:paddingBottom="15dp">

        <TextView
            android:id="@+id/textView31"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0px"
            android:fontFamily="@font/dm_sans_bold"
            android:gravity="center"
            android:text="Inserta la tajeta"
            android:textAlignment="center"
            android:textColor="#0F0F0F"
            android:textSize="40px" />

        <TextView
            android:id="@+id/textView33"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24px"
            android:fontFamily="@font/dm_sans_bold"
            android:gravity="center"
            android:text="antes de continuar"
            android:textAlignment="center"
            android:textColor="#0F0F0F"
            android:textSize="40px" />

        <TextView
            android:id="@+id/textView30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans"
            android:text="Para realizar el cobro, la tarjeta debe"
            android:textColor="#5A5A5A"
            android:textSize="30px" />

        <TextView
            android:id="@+id/textView32"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans"
            android:text="estar insertada"
            android:textColor="#5A5A5A"
            android:textSize="30px"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ticket_separator"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#000000"
        android:layout_marginBottom="24px"
        android:orientation="horizontal"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_alert_print_close"
        android:layout_width="339px"
        android:layout_height="80px"
        android:background="@drawable/rounded_corner"
        android:backgroundTint="#000000"
        android:fontFamily="@font/dm_sans_bold"
        android:minHeight="50dip"
        android:stateListAnimator="@null"
        android:text="Continuar"
        android:textAllCaps="false"
        android:textColor="#ffffff"
        android:textSize="22px" />

</LinearLayout>