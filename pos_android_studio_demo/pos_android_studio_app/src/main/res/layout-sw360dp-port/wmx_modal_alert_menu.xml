<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="37px"
    android:paddingTop="28px"
    android:paddingBottom="28px"
    android:paddingRight="37px">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tp_warning"
            android:layout_width="match_parent"
            android:layout_height="100px"
            android:layout_marginBottom="18px"
            app:srcCompat="@drawable/efevoo_i_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ticket_totales"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:paddingBottom="15dp">

        <TextView
            android:id="@+id/modal_text_mensaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0px"
            android:fontFamily="@font/dm_sans_bold"
            android:gravity="center"
            android:text="Mensaje"
            android:textAlignment="center"
            android:textColor="#0F0F0F"
            android:textSize="30px" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ticket_separator"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#000000"
        android:layout_marginBottom="24px"
        android:orientation="horizontal"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_alert_try"
        android:layout_width="match_parent"
        android:layout_height="80px"
        android:background="@drawable/rounded_corner"
        android:backgroundTint="#0083BE"
        android:fontFamily="@font/dm_sans_bold"
        android:minHeight="50dip"
        android:stateListAnimator="@null"
        android:text="Reintentar"
        android:textAllCaps="false"
        android:textColor="#ffffff"
        android:textSize="22px" />

</LinearLayout>