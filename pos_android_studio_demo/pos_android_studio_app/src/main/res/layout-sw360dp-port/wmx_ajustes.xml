<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/toolbar_layout" />

        <!--    <LinearLayout-->
        <!--        android:layout_width="match_parent"-->
        <!--        android:layout_height="5px"-->
        <!--        android:background="#A9FF85"-->
        <!--        android:gravity="center_horizontal">-->

        <!--        <LinearLayout-->
        <!--            android:layout_width="100px"-->
        <!--            android:layout_height="5px"-->
        <!--            android:background="#8591FF" />-->
        <!--    </LinearLayout>-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ep_fondo"
            android:orientation="vertical"
            android:paddingLeft="70px"
            android:paddingTop="70px"
            android:paddingRight="70px">

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="55px"
                android:fontFamily="@font/dm_sans_medium"
                android:gravity="center_horizontal"
                android:text="Información General"
                android:textColor="#0F0F0F"
                android:textSize="37px" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans"
                    android:text="Version:"
                    android:textColor="@color/ep_color_black"
                    android:textSize="30px" />

                <TextView
                    android:id="@+id/txtversion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="end"
                    android:text="1.4.5.p.a"
                    android:textColor="#5A5A5A"
                    android:textSize="30px" />
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40px"
                android:layout_marginBottom="40px"
                android:contentDescription="underline"
                android:layerType="software"
                android:src="@drawable/dotted_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans"
                    android:text="Modelo:"
                    android:textColor="@color/ep_color_black"
                    android:textSize="30px" />

                <TextView
                    android:id="@+id/txtmodelo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="end"
                    android:text="A910"
                    android:textColor="#5A5A5A"
                    android:textSize="30px" />

            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40px"
                android:layout_marginBottom="40px"
                android:contentDescription="underline"
                android:layerType="software"
                android:src="@drawable/dotted_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans"
                    android:text="Número de serie:"
                    android:textColor="@color/ep_color_black"
                    android:textSize="30px" />

                <TextView
                    android:id="@+id/textView10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="end"
                    android:text="1491040530"
                    android:textColor="#5A5A5A"
                    android:textSize="30px" />
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="40px"
                android:layout_marginBottom="40px"
                android:contentDescription="underline"

                android:layerType="software"
                android:src="@drawable/dotted_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView11"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans"
                    android:text="Store ID:"
                    android:textColor="@color/ep_color_black"
                    android:textSize="30px" />

                <TextView
                    android:id="@+id/textView12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="end"
                    android:text="1141054"
                    android:textColor="#5A5A5A"
                    android:textSize="30px" />
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="30px"
                android:layout_marginBottom="30px"
                android:contentDescription="underline"

                android:layerType="software"
                android:src="@drawable/dotted_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView11"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans"
                    android:text="Terminal:"
                    android:textColor="@color/ep_color_black"
                    android:textSize="30px" />

                <TextView
                    android:id="@+id/txtksn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="end"
                    android:text="ksn"
                    android:textColor="#5A5A5A"
                    android:textSize="30px" />
            </LinearLayout>

            <Button
                android:id="@+id/WMX_btn_initialize_keys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30px"
                android:fontFamily="@font/dm_sans_bold"
                android:text="Inicializar llaves"
                android:textAllCaps="false"
                android:visibility="visible" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40px"
                android:contentDescription="underline"
                android:layerType="software"
                android:src="@drawable/straight_line" />
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>